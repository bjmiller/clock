{
  "env": {
    "es6": true,
    "node": true,
    "jest": true,
    "browser": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "globals": {},
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "plugins": [
    "prettier",
    "@typescript-eslint/eslint-plugin"
  ],
  "settings": {},
  "overrides": [
    {
      "files": [
        "*.test.js"
      ]
    }
  ],
  "rules": {
    "prettier/prettier": [
      "error"
    ],
    "@typescript-eslint/no-explicit-any": "error",
    "arrow-body-style": "off",
    "curly": [
      "error",
      "all"
    ],
    "prefer-arrow-callback": "off",
    "no-extra-semi": "off",
    "no-mixed-spaces-and-tabs": "off",
    "no-unexpected-multiline": "off",
    "default-case": [
      "error"
    ],
    "dot-notation": [
      "error",
      {
        "allowKeywords": false
      }
    ],
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "func-name-matching": [
      "error"
    ],
    "guard-for-in": [
      "warn"
    ],
    "max-len": [
      "error",
      {
        "code": 120,
        "ignoreTrailingComments": true,
        "ignoreUrls": true,
        "ignoreTemplateLiterals": true
      }
    ],
    "no-array-constructor": [
      "error"
    ],
    "no-await-in-loop": [
      "error"
    ],
    "no-buffer-constructor": [
      "error"
    ],
    "no-confusing-arrow": [
      "error",
      {
        "allowParens": true
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "error"
        ]
      }
    ],
    "no-duplicate-imports": [
      "error"
    ],
    "no-eval": [
      "error"
    ],
    "no-extra-bind": [
      "warn"
    ],
    "no-implicit-coercion": [
      "error"
    ],
    "no-implicit-globals": [
      "error"
    ],
    "no-implied-eval": [
      "error"
    ],
    "no-lonely-if": [
      "error"
    ],
    "no-loop-func": [
      "error"
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [
          -1,
          0,
          1
        ],
        "ignoreArrayIndexes": true,
        "detectObjects": true
      }
    ],
    "no-misleading-character-class": [
      "error"
    ],
    "no-multi-str": [
      "error"
    ],
    "no-new": [
      "error"
    ],
    "no-new-object": [
      "error"
    ],
    "no-new-require": [
      "error"
    ],
    "no-new-wrappers": [
      "error"
    ],
    "no-param-reassign": [
      "error",
      {
        "props": false
      }
    ],
    "no-return-assign": [
      "error"
    ],
    "no-shadow": [
      "error",
      {
        "builtinGlobals": true
      }
    ],
    "no-shadow-restricted-names": [
      "error"
    ],
    "no-template-curly-in-string": [
      "warn"
    ],
    "no-throw-literal": [
      "error"
    ],
    "no-undef-init": [
      "error"
    ],
    "no-unmodified-loop-condition": [
      "error"
    ],
    "no-unused-expressions": [
      "warn",
      {
        "allowTaggedTemplates": true
      }
    ],
    "no-unused-vars": [
      "off"
    ],
    "@typescript-eslint/no-unused-vars": [
      "warn"
    ],
    "no-var": [
      "warn"
    ],
    "one-var": [
      "warn",
      "never"
    ],
    "prefer-const": [
      "error"
    ],
    "prefer-template": [
      "warn"
    ],
    "radix": [
      "error"
    ],
    "require-await": [
      "error"
    ],
    "sort-imports": [
      "off"
    ],
    "yoda": [
      "error",
      "never",
      {
        "exceptRange": true
      }
    ]
  }
}
